post_patch() {
	# TODO: This will fail anyways, due to the lack of reform-qcacld2 drivers.
	vsed -i "bin/reform-hw-setup" \
		-e 's/^  KERNVER_EXACT=.*/  KERNVER_EXACT="$(uname -r)"/'
}

do_install() {
	# TODO: Ideally, I would just use the gnu-makefile build style but this
	# would currently fail because of reform-check/distro/void.sh not existing.

	vmkdir usr/bin
	vcopy 'bin/*' usr/bin
	# TODO: Move to -tweaks, when "kernel/" files are ported.
	vmkdir usr/share/reform-tools
	vcopy machines usr/share/reform-tools

	# The local copies of the handbooks are not installed by any package.
	rm ${DESTDIR}/usr/bin/pocket-reform-handbook
	rm ${DESTDIR}/usr/bin/reform-handbook

	# This invokes APT/dpkg-*.
	# TODO: Convert this to xbps, where possible.
	rm ${DESTDIR}/usr/bin/reform-emmc-bootstrap
	rm ${DESTDIR}/usr/bin/reform-flash-bootloader

	# These mess with the initramfs and do not currently support Void.
	rm ${DESTDIR}/usr/bin/reform-boot-config
	rm ${DESTDIR}/usr/bin/reform-display-config
	rm ${DESTDIR}/usr/bin/reform-flash-rescue
	rm ${DESTDIR}/usr/bin/reform-migrate
	rm ${DESTDIR}/usr/bin/reform-setup-encrypted-disk

	# This assumes the existence of an 'irc' program, which is not currently
	# packaged.
	# TODO: Figure out which program is (or possible programs are) being invoked.
	rm ${DESTDIR}/usr/bin/reform-chat

	# This is somewhat OS-specific.
	# TODO: Investigate whether forcing offline mode produces a reasonable result.
	# TODO: Install `reform-check/common.sh` and other scripts, once this is used.
	rm ${DESTDIR}/usr/bin/reform-check

	# I am unsure of the utility of this. I think it is handled by xbps-reconfigure
	# (if it is not done automatically).
	rm ${DESTDIR}/usr/bin/reform-config

	# I am also unsure of the utility of these.
	rm ${DESTDIR}/usr/bin/reform-gnome-config
	rm ${DESTDIR}/usr/bin/reform-help
	rm ${DESTDIR}/usr/bin/reform-pavucontrol
	rm ${DESTDIR}/usr/bin/reform-waybar-icon-wedge

	# These were renamed and do nothing.
	rm ${DESTDIR}/usr/bin/reform-flash-uboot
	rm ${DESTDIR}/usr/bin/reform-setup-encrypted-nvme
}

reform-tweaks_package() {
	depends="alsa-utils python3-libusb1"
	short_desc="Tweaks and fixes for the MNT Reform"

	pkg_install() {
		# This was introduced for the A311D (BPi CM4), which has integrated
		# wifi, and may be optional on other SoMs.
		# TODO: Should we add similar for other network daemons?
		vinstall NetworkManager/default-wifi-powersave-off.conf 644 usr/lib/NetworkManager/conf.d

		vinstall audio/99-reform-audio.rules 644 usr/lib/udev/rules.d
		vinstall audio/analog-input-reform.conf 644 usr/share/pulseaudio/alsa-mixer/paths
		vinstall audio/asound.state 644 var/lib/alsa
		vinstall audio/reform.conf 644 usr/share/pulseaudio/alsa-mixer/profile-sets
		vinstall audio/reform-hdmi-audio-priority.conf 644 usr/share/wireplumber/wireplumber.conf.d
		vinstall audio/ucm2.conf.d/rk3588-tlv320ai/HiFi.conf 644 usr/share/alsa/ucm2/conf.d/rk3588-tlv320ai
		vinstall audio/ucm2.conf.d/rk3588-tlv320ai/rk3588-tlv320aic3100.conf 644 usr/share/alsa/ucm2/conf.d/rk3588-tlv320ai

		# TODO: Is the KWin tweak only needed on kwin?
		vmkdir etc/profile.d
		vcopy 'etc/profile.d/*' etc/profile.d

		# TODO: Port flash-kernel files.
		# TODO: Port initramfs files.
		# TODO: Port kernel files.
		# TODO: Port kernel-install files.

		vmkdir usr/libexec
		# TODO: Are these all useful?
		vcopy libexec/reform-tools usr/libexec
		# TODO: These are probably in the wrong folder.
		vmove usr/bin/reform-standby
		vmove usr/bin/reform-hw-setup

		# This is used by "reform-power-daemon".
		vmove usr/bin/reform-mcu-tool

		# TODO: Ideally, reform-hw-setup would be run in core-services (as a
		# one-shot). Unfortunately, my initial attempts did not seem to work. I
		# am unsure why not, but my guess would be that it was running too
		# early, somehow.
		vsv reform-hw-setup
		vsv reform-power-daemon

		# TODO: Figure out how to disable hibernation and, on non–i.MX 8MQ,
		# sleep.
		vinstall udev/reform-ttymxc-wakeup.rules 644 usr/lib/udev/rules.d
		vinstall ${FILESDIR}/reform-suspend 755 etc/zzz.d/suspend
		vinstall ${FILESDIR}/reform-resume 755 etc/zzz.d/resume

		vinstall modprobe.d/reform.conf 644 usr/lib/modprobe.d

		# TODO: Plymouth
	}
}
